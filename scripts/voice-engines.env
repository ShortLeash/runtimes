# The two C++ engines DevKit's local AI uses, each with its own ggml. The
# release is named after the two crates DevKit links them through:
# voice-engines-<transcribe-cpp-sys version>-<llama-cpp-sys-2 version>.
#
# transcribe.cpp (MIT) at the tag that is the transcribe-cpp-sys crate's
# version: the crate checks its bindings against the library's ABI hash, so
# the two pins move together.
TRANSCRIBE_VERSION=0.4.0
# The crate's SHA-256 (crates.io, Cargo.lock); the crate records the commit
# it was packaged from, which must be this one.
TRANSCRIBE_CPP_SYS_SHA256=7f0976932ee2a0d9bcfb7a90947d0a73771cee383b163bd7189a8e0d67da1157
TRANSCRIBE_COMMIT=f1dcd15858c4bbba87ca97862b4e448b2cf15b8f
# llama.cpp (MIT) plus its common library, at the commit the llama-cpp-sys-2
# crate's llama.cpp submodule points to (v0.6.0; later than b8146, which
# fixed CVE-2026-27940 in the GGUF parser).
LLAMA_CPP_SYS_VERSION=0.1.160
# The crate's SHA-256 (crates.io, Cargo.lock). Its copy of llama.cpp must
# match the commit's files.
LLAMA_CPP_SYS_SHA256=912d8a0522acec022ae07d099366234067c8af6a18570a603f0749b7bb927e9a
LLAMA_COMMIT=d81235049384534c167caea52b85a694f6103d14
# The Vulkan SDK for the Windows Vulkan backend, checked against the SHA-256
# LunarG publishes for it (pinned here too). glslc's version decides which
# shaders get built, so the version is recorded in each build's BUILDINFO.
VULKAN_SDK_VERSION=1.4.363.0
VULKAN_SDK_SHA256=94a82d378f7a5e3e54c9db7d2fb7016af136e14ac0a18dbf0f2f67a36352d141
# Test inputs for the smoke tests only, never shipped: llama.cpp's own tiny
# test model, and transcribe.cpp's whisper-tiny conversion, by Hugging Face
# commit and SHA-256.
LLAMA_SMOKE_REPO=ggml-org/test-model-stories260K
LLAMA_SMOKE_COMMIT=479896ec924af6d40fd419ab8f4d1eb2101de00d
LLAMA_SMOKE_FILE=stories260K-f32.gguf
LLAMA_SMOKE_SHA256=270cba1bd5109f42d03350f60406024560464db173c0e387d91f0426d3bd256d
TRANSCRIBE_SMOKE_REPO=handy-computer/whisper-tiny-gguf
TRANSCRIBE_SMOKE_COMMIT=1bd61cda36bbd22c88fc5a33842498a6e1d30f45
TRANSCRIBE_SMOKE_FILE=whisper-tiny-Q5_K_M.gguf
TRANSCRIBE_SMOKE_SHA256=72cfa8ee436a635a5b6fb373cc056a828b9efe96d32d6eb8769ed3cc5b429719
