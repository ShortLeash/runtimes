+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#ifndef TIMERLIB_WIN32_H
+#define TIMERLIB_WIN32_H
+
+#include <winsock2.h>
+#include <windows.h>
+#include <time.h>
+
+typedef struct timespec timerlib_timespec_t;
+
+/**
+ * A timer backed by a waitable timer (high-resolution where Windows has
+ * them, from Windows 10 version 1803) and a thread of its own that waits on
+ * it, as the kqueue timer has. Only wall-clock time: Windows has no timer
+ * that runs on a thread's CPU time, so TIMERLIB_HAVE_CPU_CLOCK isn't
+ * defined and EXCIMER_CPU isn't offered.
+ */
+typedef struct {
+	/** The waitable timer, or NULL when not started */
+	HANDLE timer;
+	/** Set to stop the thread */
+	HANDLE stop_event;
+	/** The thread that waits on the timer and notifies */
+	HANDLE thread;
+	/** The period of this timer, zero for a one-shot timer */
+	struct timespec period;
+	/** The delay before the first expiration */
+	struct timespec initial;
+	/** Pointer to a callback to be invoked when this timer fires */
+	timerlib_notify_function_t *notify_function;
+	/** Data to be passed to the callback */
+	void *notify_data;
+	/** The time at which this timer last fired */
+	struct timespec last_fired_at;
+	/** Protects last_fired_at from concurrent access */
+	SRWLOCK last_fired_at_lock;
+} timerlib_timer_t;
+
+#endif
