diff --git a/timerlib/timerlib_win32.c b/timerlib/timerlib_win32.c
new file mode 100644
index 0000000..7dedfdc
--- /dev/null
+++ b/timerlib/timerlib_win32.c
@@ -0,0 +1,228 @@
+/* Copyright 2026 the ShortLeash/runtimes contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Timers for Windows. Each timer has a thread that waits on a waitable timer
+ * and calls the notify function when it expires, as the kqueue timer's
+ * thread does; the notify function only flags the PHP thread, which takes
+ * the sample at its next interrupt check. A periodic timer is re-armed for
+ * each period from when it should have fired, so it doesn't drift; periods
+ * the thread missed are passed on as overruns, as POSIX timers count them.
+ */
+
+#include "timerlib.h"
+
+#include <limits.h>
+#include <process.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+/** Ticks of QueryPerformanceCounter per second. */
+static LONGLONG timerlib_win32_frequency(void)
+{
+	static LONGLONG frequency = 0;
+	if (frequency == 0) {
+		LARGE_INTEGER f;
+		QueryPerformanceFrequency(&f);
+		frequency = f.QuadPart;
+	}
+	return frequency;
+}
+
+/** Nanoseconds on the performance counter. */
+static uint64_t timerlib_win32_now_ns(void)
+{
+	LARGE_INTEGER now;
+	LONGLONG frequency = timerlib_win32_frequency();
+	QueryPerformanceCounter(&now);
+	return (uint64_t)(now.QuadPart / frequency) * TIMERLIB_BILLION_LL
+		+ (uint64_t)(now.QuadPart % frequency) * TIMERLIB_BILLION_LL / (uint64_t)frequency;
+}
+
+static void timerlib_win32_ns_to_timespec(uint64_t ns, timerlib_timespec_t *ts)
+{
+	ts->tv_sec = (time_t)(ns / TIMERLIB_BILLION_LL);
+	ts->tv_nsec = (long)(ns % TIMERLIB_BILLION_LL);
+}
+
+/** Reports a failed Windows call in the main thread. */
+static void timerlib_win32_report(const char *func)
+{
+	php_error_docref(NULL, E_WARNING, "Error in %s(): Windows error %lu", func, (unsigned long)GetLastError());
+}
+
+/** Closes and forgets a handle. */
+static void timerlib_win32_close(HANDLE *handle)
+{
+	if (*handle) {
+		CloseHandle(*handle);
+		*handle = NULL;
+	}
+}
+
+static unsigned __stdcall timerlib_win32_thread(void *arg)
+{
+	timerlib_timer_t *timer = (timerlib_timer_t*)arg;
+	uint64_t period = timerlib_timespec_to_ns(&timer->period);
+	uint64_t fire_at = timerlib_win32_now_ns() + timerlib_timespec_to_ns(&timer->initial);
+	HANDLE handles[2] = {timer->stop_event, timer->timer};
+
+	for (;;) {
+		uint64_t now = timerlib_win32_now_ns();
+		/* Relative due times are negative, in units of 100 ns. */
+		LONGLONG wait = fire_at > now ? (LONGLONG)((fire_at - now + 99) / 100) : 1;
+		LARGE_INTEGER due;
+		DWORD woke;
+
+		due.QuadPart = -wait;
+		if (!SetWaitableTimerEx(timer->timer, &due, 0, NULL, NULL, NULL, 0)) {
+			timerlib_abort("SetWaitableTimerEx", (int)GetLastError());
+		}
+		woke = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+		if (woke == WAIT_OBJECT_0) {
+			break;
+		}
+		if (woke != WAIT_OBJECT_0 + 1) {
+			timerlib_abort("WaitForMultipleObjects", (int)GetLastError());
+		}
+
+		now = timerlib_win32_now_ns();
+		AcquireSRWLockExclusive(&timer->last_fired_at_lock);
+		timerlib_win32_ns_to_timespec(now, &timer->last_fired_at);
+		ReleaseSRWLockExclusive(&timer->last_fired_at_lock);
+
+		if (period == 0) {
+			timer->notify_function(timer->notify_data, 0);
+			break;
+		}
+		/* This expiration, and any the thread missed since. */
+		uint64_t expired = now > fire_at ? (now - fire_at) / period + 1 : 1;
+		fire_at += expired * period;
+		timer->notify_function(timer->notify_data, expired - 1 > INT_MAX ? INT_MAX : (int)(expired - 1));
+	}
+	return 0;
+}
+
+int timerlib_timer_init(timerlib_timer_t *timer, int clock,
+		timerlib_notify_function_t *notify_function, void *notify_data)
+{
+	memset(timer, 0, sizeof(*timer));
+	timer->notify_function = notify_function;
+	timer->notify_data = notify_data;
+	InitializeSRWLock(&timer->last_fired_at_lock);
+	if (clock != TIMERLIB_REAL) {
+		php_error_docref(NULL, E_WARNING, "CPU time timers aren't available on Windows");
+		return TIMERLIB_FAILURE;
+	}
+	return TIMERLIB_SUCCESS;
+}
+
+int timerlib_timer_start(timerlib_timer_t *timer, timerlib_timespec_t *period, timerlib_timespec_t *initial)
+{
+	timer->period = *period;
+	timer->initial = *initial;
+
+	timer->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+	if (!timer->timer) {
+		/* Before Windows 10 version 1803: the system timer's resolution. */
+		timer->timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+	}
+	if (!timer->timer) {
+		timerlib_win32_report("CreateWaitableTimerExW");
+		return TIMERLIB_FAILURE;
+	}
+	timer->stop_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+	if (!timer->stop_event) {
+		timerlib_win32_report("CreateEventW");
+		timerlib_win32_close(&timer->timer);
+		return TIMERLIB_FAILURE;
+	}
+
+	timerlib_clock_get_time(TIMERLIB_REAL, &timer->last_fired_at);
+
+	timer->thread = (HANDLE)_beginthreadex(NULL, 0, timerlib_win32_thread, timer, 0, NULL);
+	if (!timer->thread) {
+		php_error_docref(NULL, E_WARNING, "Error in _beginthreadex(): %s", strerror(errno));
+		timerlib_win32_close(&timer->stop_event);
+		timerlib_win32_close(&timer->timer);
+		return TIMERLIB_FAILURE;
+	}
+	return TIMERLIB_SUCCESS;
+}
+
+int timerlib_timer_stop(timerlib_timer_t *timer)
+{
+	if (timer->thread) {
+		SetEvent(timer->stop_event);
+		/* Wait for the thread, so the callback isn't called after this. */
+		WaitForSingleObject(timer->thread, INFINITE);
+		timerlib_win32_close(&timer->thread);
+	}
+	timerlib_win32_close(&timer->stop_event);
+	if (timer->timer) {
+		CancelWaitableTimer(timer->timer);
+		timerlib_win32_close(&timer->timer);
+	}
+	timer->period.tv_sec = 0;
+	timer->period.tv_nsec = 0;
+	return TIMERLIB_SUCCESS;
+}
+
+void timerlib_timer_destroy(timerlib_timer_t *timer)
+{
+	timerlib_timer_stop(timer);
+}
+
+int timerlib_timer_get_time(timerlib_timer_t *timer, timerlib_timespec_t *remaining)
+{
+	timerlib_timespec_t last_fired_at;
+	timerlib_timespec_t now;
+
+	AcquireSRWLockShared(&timer->last_fired_at_lock);
+	last_fired_at = timer->last_fired_at;
+	ReleaseSRWLockShared(&timer->last_fired_at_lock);
+
+	/* The next expiry is a period after the last, as the kqueue timer reckons it. */
+	*remaining = timer->period;
+	timerlib_timespec_add(remaining, &last_fired_at);
+	timerlib_clock_get_time(TIMERLIB_REAL, &now);
+	timerlib_timespec_subtract(remaining, &now);
+	return TIMERLIB_SUCCESS;
+}
+
+int timerlib_clock_get_time(int clock, timerlib_timespec_t *time)
+{
+	if (clock == TIMERLIB_CPU) {
+		FILETIME created, exited, kernel, user;
+		ULARGE_INTEGER k, u;
+		if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user)) {
+			timerlib_win32_report("GetThreadTimes");
+			return TIMERLIB_FAILURE;
+		}
+		k.LowPart = kernel.dwLowDateTime;
+		k.HighPart = kernel.dwHighDateTime;
+		u.LowPart = user.dwLowDateTime;
+		u.HighPart = user.dwHighDateTime;
+		/* FILETIME counts 100 ns. */
+		timerlib_win32_ns_to_timespec((k.QuadPart + u.QuadPart) * 100, time);
+		return TIMERLIB_SUCCESS;
+	}
+	timerlib_win32_ns_to_timespec(timerlib_win32_now_ns(), time);
+	return TIMERLIB_SUCCESS;
+}
