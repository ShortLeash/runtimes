# PostGIS and the libraries DevKit's PostGIS builds link statically. Each
# input's check is named beside it; scripts/postgis.sh fetches exactly these.

# PostGIS: the pinned SHA-256, and download.osgeo.org's .md5 checked at build
# time. When pinned, the SHA-256 matched Homebrew's postgis formula and the
# MD5 matched osgeo's (c2f5d43c7e5df0ec1af37ef60d95e0d2 for 3.6.4).
POSTGIS_VERSION=3.6.4
POSTGIS_SHA256=ed8dc6679f1e06f7b113592b04cde2a7e00f1b1e681294c8ca2204058990cec6

# GEOS: GitHub's digest for the release asset (fetch_github_asset). PostGIS
# 3.6 asks for GEOS 3.14 for every feature and its docs name nothing newer,
# so it stays on 3.14.x. 3.14.1's digest
# (3c20919cda9a505db07b5216baa980bacdaa0702da715b43f176fb07eff7e716) also
# matched the tarball on download.osgeo.org.
GEOS_VERSION=3.14.1

# PROJ: GitHub's digest for the release asset; it matched Homebrew's proj
# formula (791a0610547eeabb17006cfd49cdbd2034f3240f47ed5e88a1031811f4e2bcf3).
PROJ_VERSION=9.9.0

# json-c: GitHub's digest for the release asset under this tag; it matched
# Homebrew's json-c formula, which downloads json-c's own S3 copy
# (37ad0249902e301bd9052bf712e511fcc6acff4ecaad4b5900aad9ce564e26de).
JSONC_TAG=json-c-0.19-20260627
JSONC_VERSION=0.19

# protobuf-c (its runtime library only): GitHub publishes no digest for the
# release asset, so it's pinned, like memcached. The pin matched Homebrew's
# protobuf-c formula.
PROTOBUFC_VERSION=1.5.2
PROTOBUFC_SHA256=e2c86271873a79c92b58fef7ebf8de1aa0df4738347a8bd5d4e65a80a16d0d24

# Windows only (scripts/postgis-windows.sh), where neither comes with the
# system, so both are built from source and linked in statically:
# libxml2: the pinned SHA-256, and download.gnome.org's .sha256sum checked at
# build time (it matched when pinned).
LIBXML2_VERSION=2.15.4
LIBXML2_SHA256=98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821
# SQLite (PROJ's database engine, and the sqlite3 program that writes
# proj.db): the pinned SHA-256. sqlite.org lists only the newest release's
# SHA3-256, which matched when pinned
# (b6ced585c750916b1052667239a12c25a7ff34e7f06e1e6e01ecb0427657d9c4).
SQLITE_VERSION=3.54.1
SQLITE_TARBALL=2026/sqlite-autoconf-3540100.tar.gz
SQLITE_SHA256=926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e
