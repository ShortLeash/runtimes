# PHP extensions for windows.php.net's official PHP (non-thread-safe, x64):
# one DLL per extension per PHP minor, built with the compiler that minor's
# PHP uses (vs16 for 8.0 to 8.3, vs17 for 8.4 and 8.5, as releases.json names
# them), and loaded into that PHP before it's released. Each release is
# php-ext-<ext>-<version>; scripts/plan.py builds only the files not on the
# releases yet.
#
# How each source is checked:
# - git: built from the extension's tag, which must point at the pinned commit
#   (annotated tags are followed to their commit).
# - pecl: built from the PECL tarball, checked against the pinned SHA-256
#   (PECL publishes no checksum).
# - dll: the extension's own Windows DLL from its GitHub release, checked
#   against GitHub's digest, or the pinned SHA-256 for releases older than
#   GitHub's digests. Repackaged unchanged.
# - microsoft: Microsoft's DLLs from its GitHub release, checked the same way,
#   and kept only with a valid Authenticode signature from Microsoft.
#   Repackaged unchanged, so the signature stays in the DLL.
# The PHP devel pack and the PHP each DLL is loaded into come from
# windows.php.net, checked against the SHA-256 in its releases.json.
#
# A pin for one minor overrides the extension's own: <EXT>_<KEY>_PHP<XY>
# (MONGODB_VERSION_PHP80) wins over <EXT>_<KEY> (MONGODB_VERSION).
# <EXT>_SKIP lists the minors an extension isn't built for.
PHP_EXT_WINDOWS=apcu igbinary msgpack pcov redis opentelemetry grpc

# The PHP SDK, at the commit its tag points at: the devel pack's configure.bat
# needs its bison, re2c and sed, and checks its version.
PHP_SDK_TAG=php-sdk-2.8.4
PHP_SDK_COMMIT=cfe7325dfdc9f20e54e85fb8929e32625d5f624e

APCU_SOURCE=git
APCU_REPO=krakjoe/apcu
APCU_TAG=v5.1.28
APCU_VERSION=5.1.28
APCU_COMMIT=819fce90c469a5666b1706036cd66120af419f1f
APCU_CONFIGURE=--enable-apcu
APCU_SKIP=

# igbinary 3.2.16 includes ext/standard/php_smart_string.h, which PHP 8.5
# removed; the fix is only in 3.2.17RC1 so far. Add 8.5 when 3.2.17 is out.
IGBINARY_SOURCE=git
IGBINARY_REPO=igbinary/igbinary
IGBINARY_TAG=3.2.16
IGBINARY_VERSION=3.2.16
IGBINARY_COMMIT=8326f6a69ebb30dd6258dd536eb0914454fbf146
IGBINARY_CONFIGURE=--enable-igbinary
IGBINARY_SKIP=8.5

MSGPACK_SOURCE=git
MSGPACK_REPO=msgpack/msgpack-php
MSGPACK_TAG=v3.0.1
MSGPACK_VERSION=3.0.1
MSGPACK_COMMIT=e0a661605ac03459909f66802bc83a3ba16cc9da
MSGPACK_CONFIGURE=--enable-msgpack
MSGPACK_SKIP=

PCOV_SOURCE=git
PCOV_REPO=krakjoe/pcov
PCOV_TAG=v1.0.12
PCOV_VERSION=1.0.12
PCOV_COMMIT=e16c08e14da0a74fd19e2e14960382bc8f28292d
PCOV_CONFIGURE=--enable-pcov
PCOV_SKIP=

# The tag is annotated; this is the commit it points at.
REDIS_SOURCE=git
REDIS_REPO=phpredis/phpredis
REDIS_TAG=6.3.0
REDIS_VERSION=6.3.0
REDIS_COMMIT=df4fab2de7fc327c54c94a13af2b9542e4fbd720
REDIS_CONFIGURE=--enable-redis
REDIS_SKIP=

# The extension lives in the repository's ext folder, and its package.xml
# asks for PHP 8.1 or newer. The tag is annotated; this is its commit.
OPENTELEMETRY_SOURCE=git
OPENTELEMETRY_REPO=open-telemetry/opentelemetry-php-instrumentation
OPENTELEMETRY_TAG=1.4.2
OPENTELEMETRY_VERSION=1.4.2
OPENTELEMETRY_COMMIT=273e09e15524ac3fa4f45120c0c2e7674e83ba2d
OPENTELEMETRY_SUBDIR=ext
OPENTELEMETRY_CONFIGURE=--enable-opentelemetry
OPENTELEMETRY_SKIP=8.0

# From PECL, because the GitHub checkout needs gRPC's submodules. The tarball
# carries config.w32.
GRPC_SOURCE=pecl
GRPC_VERSION=1.84.0
GRPC_SHA256=555716233a5cc9a6baa605719f87b7688a88fb8bfdd9b4493396276244d56625
GRPC_CONFIGURE=--with-grpc
GRPC_SKIP=

# 2.5.5 publishes DLLs for 8.1 to 8.5, with GitHub digests. 1.20.1 is the
# newest with one for 8.0 (named x64_86, and an x64 DLL); it has no digest,
# so its SHA-256 is pinned. The DLL in each zip carries the asset's name.
MONGODB_SOURCE=dll
MONGODB_REPO=mongodb/mongo-php-driver
MONGODB_VERSION=2.5.5
MONGODB_ASSET=php_mongodb-{version}-{minor}-nts-{compiler}-x86_64.zip
MONGODB_VERSION_PHP80=1.20.1
MONGODB_ASSET_PHP80=php_mongodb-1.20.1-8.0-nts-vs16-x64_86.zip
MONGODB_SHA256_PHP80=56232673ec2a41200e0173a2d283ea617b9ca2ad47c114a74138b588460afcb2
MONGODB_SKIP=

# Microsoft's drivers. Windows_5.13.3RTW.zip has DLLs for 8.3, 8.4 and 8.5
# (Windows/php_sqlsrv_<XY>_nts_x64.dll), with a GitHub digest.
# Windows_5.12.0RTW.zip has 8.1 to 8.3 in the same layout, and 5.11.1's
# Windows-8.0.zip has 8.0 in a folder per architecture
# (Windows-8.0/x64/php_sqlsrv_80_nts.dll). Neither older release has a
# digest, so their SHA-256s are pinned.
SQLSRV_SOURCE=microsoft
SQLSRV_REPO=microsoft/msphpsql
SQLSRV_VERSION=5.13.3
SQLSRV_TAG=v5.13.3
SQLSRV_ASSET=Windows_5.13.3RTW.zip
SQLSRV_VERSION_PHP80=5.11.1
SQLSRV_TAG_PHP80=v5.11.1
SQLSRV_ASSET_PHP80=Windows-8.0.zip
SQLSRV_SHA256_PHP80=4c79a0850d87535814f851bccf0be1dc5459143a76f58e639a4d39463a2d740d
SQLSRV_VERSION_PHP81=5.12.0
SQLSRV_TAG_PHP81=v5.12.0
SQLSRV_ASSET_PHP81=Windows_5.12.0RTW.zip
SQLSRV_SHA256_PHP81=48c2067c8fc4683418d3096807af92a65660245be846a61bb65f93d28272ff71
SQLSRV_VERSION_PHP82=5.12.0
SQLSRV_TAG_PHP82=v5.12.0
SQLSRV_ASSET_PHP82=Windows_5.12.0RTW.zip
SQLSRV_SHA256_PHP82=48c2067c8fc4683418d3096807af92a65660245be846a61bb65f93d28272ff71
SQLSRV_SKIP=

# The same release files as sqlsrv; each holds both drivers.
PDO_SQLSRV_SOURCE=microsoft
PDO_SQLSRV_REPO=microsoft/msphpsql
PDO_SQLSRV_VERSION=5.13.3
PDO_SQLSRV_TAG=v5.13.3
PDO_SQLSRV_ASSET=Windows_5.13.3RTW.zip
PDO_SQLSRV_VERSION_PHP80=5.11.1
PDO_SQLSRV_TAG_PHP80=v5.11.1
PDO_SQLSRV_ASSET_PHP80=Windows-8.0.zip
PDO_SQLSRV_SHA256_PHP80=4c79a0850d87535814f851bccf0be1dc5459143a76f58e639a4d39463a2d740d
PDO_SQLSRV_VERSION_PHP81=5.12.0
PDO_SQLSRV_TAG_PHP81=v5.12.0
PDO_SQLSRV_ASSET_PHP81=Windows_5.12.0RTW.zip
PDO_SQLSRV_SHA256_PHP81=48c2067c8fc4683418d3096807af92a65660245be846a61bb65f93d28272ff71
PDO_SQLSRV_VERSION_PHP82=5.12.0
PDO_SQLSRV_TAG_PHP82=v5.12.0
PDO_SQLSRV_ASSET_PHP82=Windows_5.12.0RTW.zip
PDO_SQLSRV_SHA256_PHP82=48c2067c8fc4683418d3096807af92a65660245be846a61bb65f93d28272ff71
PDO_SQLSRV_SKIP=
