# MariaDB releases DevKit builds, with their source tarballs' SHA-256 (also
# checked against archive.mariadb.org's sha256sums.txt), and the versions of
# the libraries MariaDB's CMake would download with only an MD5.
MARIADB_11_8=11.8.9
MARIADB_11_8_SHA256=2e015b7e91004142eda8b3a20d3ceb875cf2ae55e72603e7222cd497d4e56fc6
MARIADB_10_11=10.11.19
MARIADB_10_11_SHA256=b8e543ee69d380fb1cfd563226f49e0fe96e4d67e7b7a9045ee514a168ed2066
MARIADB_FMT_VERSION=12.2.0
MARIADB_PCRE2_VERSION=10.47

# GnuTLS and Nettle, built static for MariaDB Connector/C (the client library
# the mariadb, mariadb-dump and mariadb-admin programs link): with the server's
# bundled wolfSSL, Connector/C takes GnuTLS, and it has no wolfSSL backend.
# gnupg.org and gnu.org publish only GPG signatures, so the build checks these
# pinned SHA-256s. Before pinning, each tarball's signature was checked once:
# GnuTLS 3.8.13 against the keyring on gnutls.org (RSA subkey
# A6AB53A01D237A94F9EEC4D0412748A40AFCC2FB of Alexander Sosedkin's
# E987AB7F7E89667776D05B3BB0E9DD20B29F1432; also signed by Zoltan Fridrich's
# 5D46CB0F763405A7053556F47A75A648B3F9220C), Nettle 3.10.2 against the GNU
# keyring (Niels Möller, 343C2FF0FBEE5EC2EDBEF399F3599FF828C67298). Both
# SHA-256s also match Homebrew's and Debian's.
MARIADB_GNUTLS_VERSION=3.8.13
MARIADB_GNUTLS_SHA256=ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e
MARIADB_NETTLE_VERSION=3.10.2
MARIADB_NETTLE_SHA256=fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5
