# Typesense releases DevKit ships for macOS. Nothing is built here: Typesense's
# own macOS builds are fetched from dl.typesense.org, checked and repackaged
# with their licence and sources (scripts/typesense.sh, scripts/sources.sh).
TYPESENSE_VERSIONS="30.2 29.0"

# dl.typesense.org publishes no checksums, so each archive's SHA-256 is
# pinned here, copied from the formulas Typesense publishes in its own
# Homebrew tap (github.com/typesense/homebrew-tap,
# Formula/typesense-server@<version>.rb) at this commit:
TYPESENSE_TAP_COMMIT=e1cbb07fb1dc4525952725b738cb54ae760fb689
TYPESENSE_30_2_ARM64_SHA256=7d8d6d0c33930ad20ea23dd184250547b16615944be891b2078e8a075152fa7e
TYPESENSE_30_2_AMD64_SHA256=6aa4d2d85838e03fdde9dcef4bf1584a46fc1840a215e5cbed288b63365eae75
TYPESENSE_29_0_ARM64_SHA256=c80391fdb1980501a9f0c965861d322b2aa622d776f887cb89bdd6fa5207c2bd
TYPESENSE_29_0_AMD64_SHA256=f6298738f5bc3a415ccee3715c69f76d7148e3d0487542791868759abbdc3201

# The source each release is built from: GitHub's tarball of the tag
# (github.com/typesense/typesense/archive/refs/tags/v<version>.tar.gz).
# Typesense's releases carry no assets, so there's no GitHub digest to check;
# these SHA-256s were taken from the tarballs when pinning, with the commit
# each tag pointed at.
TYPESENSE_30_2_SOURCE_COMMIT=d45d46baf3996d1de8bf96a87f375cfb43691560
TYPESENSE_30_2_SOURCE_SHA256=98ce13b5f05b68ff280b2e4b463c9a0f3be303d2c83a1e18ffbddf90f2b19ad1
TYPESENSE_29_0_SOURCE_COMMIT=1c5804194175210b3fbdd4972ba3cff2bbdf85cf
TYPESENSE_29_0_SOURCE_SHA256=9d18d171a35fb6e46bbf0f93fe2496174f4762704e117afd2ca6c5f3f34db0ed

# Typesense builds for macOS 13.1, not DevKit's 13.0; the build fails if a
# binary needs anything newer.
TYPESENSE_MACOS_MINIMUM=13.1
