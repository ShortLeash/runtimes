# libwebrtc for DevKit: LiveKit's build recipe and patches from the
# webrtc-sys crate (Apache-2.0) DevKit links, with H.264 off so no FFmpeg or
# OpenH264 is built in. The release is named after the crate version.
WEBRTC_SYS_VERSION=0.3.49
# The crate's SHA-256, as crates.io lists it (and Cargo.lock records it).
WEBRTC_SYS_SHA256=b803a52c561fbb9faaf09c1b6fc0260f337cbc1ae6f2a525f673c77eb4411022
# The WebRTC source the crate's recipe names by branch (m150_release), pinned
# to the commit that branch pointed at when it was set.
WEBRTC_COMMIT=51c367e209f8f12b39bd8dd0ca70bf588f42cb48
# depot_tools (gclient, gn, ninja), pinned likewise.
DEPOT_TOOLS_COMMIT=97ed77526c27c08ad80437625ffde66dcbdd3b9c
