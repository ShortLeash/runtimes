# The memcached release DevKit builds. memcached.org publishes only a SHA-1
# beside each tarball, so its SHA-256 is pinned here (it matches Homebrew's)
# and the build checks both. libevent comes from its GitHub release, checked
# against GitHub's digest.
MEMCACHED_VERSION=1.6.45
MEMCACHED_SHA256=d362c64e6d8d5287153501eabf7c85b4a761432fbf53f5d7b085d0bb1653c1dd
LIBEVENT_VERSION=2.1.13-stable
