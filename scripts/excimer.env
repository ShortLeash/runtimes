# Excimer, the sampling profiler in the macOS PHP builds. Its project stopped
# publishing to PECL after 1.2.6 (static-php-cli's default source), so php.sh
# builds it from a pinned commit of its repository instead: 1.2.7 plus "Fix
# build with PHP 8.6.0alpha3" (XtOffsetOf and INI_INT), which no release has
# yet, so PHP 8.6 previews get it too. Move to the next tag once one includes
# that fix. The Windows build pins the 1.2.7 tag in php-ext-windows.env (it
# builds no previews).
EXCIMER_REPO=wikimedia/mediawiki-php-excimer
EXCIMER_VERSION=1.2.7
EXCIMER_COMMIT=34183f9487bf95cd5b8dab50af737d19de5179f7
